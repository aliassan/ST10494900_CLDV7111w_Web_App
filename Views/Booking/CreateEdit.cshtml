@model EventEase.Models.Booking

@{
    string formAction = ViewData["FormAction"]?.ToString() ?? "Create";
    string pageTitle = formAction == "Create" ? "Create Booking" : "Edit Booking";
    ViewData["Title"] = pageTitle;
}

<h1>@pageTitle</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="@formAction">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BookingId" />

            <div class="form-group mb-3">
                <label asp-for="EventId" class="control-label"></label>
                <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId"></select>
                <span asp-validation-for="EventId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VenueId" class="control-label"></label>
                <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId"></select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingDate" class="control-label"></label>
                <input asp-for="BookingDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="BookingDate" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">
                    @ViewData["SubmitButtonText"]
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>