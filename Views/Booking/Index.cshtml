@model IEnumerable<BookingDetail>

@{
    ViewData["Title"] = "Bookings";
    // Get current filter values from ViewData
    var searchString = Context.Request.Query["searchString"].FirstOrDefault();
    var eventTypeIdString = Context.Request.Query["eventTypeId"].FirstOrDefault();
    int? eventTypeId = int.TryParse(eventTypeIdString, out var parsedEventTypeId) ? parsedEventTypeId : (int?)null;
    var fromDate = Context.Request.Query["fromDate"].FirstOrDefault();
    var toDate = Context.Request.Query["toDate"].FirstOrDefault();
    var unavailableOnly = Context.Request.Query["availabilityFilter"].ToString() == "unavailable";
    var availableOnly = Context.Request.Query["availabilityFilter"].ToString() == "available";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Bookings</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</div>

<!-- Enhanced Search Form -->
<form method="get" class="mb-4">
    <div class="row g-3 align-items-end"> <!-- Changed to align-items-end -->
        <!-- Search input -->
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input type="text" name="searchString" value="@searchString" 
                   class="form-control" placeholder="Booking ID or Event Name">
        </div>
        
        <!-- Event Type filter -->
        <div class="col-md-2">
            <label class="form-label">Event Type</label>
            <select name="eventTypeId" class="form-select">
                <option value="">All Types</option>
                @foreach (var type in ViewBag.EventTypes as IEnumerable<EventType> ?? new List<EventType>())
                {
                    <option value="@type.EventTypeId" selected="@(eventTypeId == type.EventTypeId)">
                        @type.TypeName
                    </option>
                }
            </select>
        </div>
        
        <!-- Date range filters -->
        <div class="col-md-2">
            <label class="form-label">From Date</label>
            <input type="date" name="fromDate" value="@fromDate" class="form-control">
        </div>
        
        <div class="col-md-2">
            <label class="form-label">To Date</label>
            <input type="date" name="toDate" value="@toDate" class="form-control">
        </div>
        
        <!-- Availability toggle -->
        @* <div class="col-md-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="availableOnly" 
                       id="availableOnly" @(availableOnly ? "checked" : "")>
                <label class="form-check-label" for="availableOnly">Available Only</label>
            </div>
        </div> *@
        <!-- Availability filter - Radio buttons -->
        @* <div class="col-md-3">
            <label class="form-label d-block">Availability</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="availabilityFilter" 
                    id="availabilityAll" value="all" @(!availableOnly && !unavailableOnly ? "checked" : "")>
                <label class="form-check-label" for="availabilityAll">All Venues</label>
            </div>
            <div class="d-flex flex-row justify-content-between align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="availabilityFilter" 
                        id="availabilityAvailable" value="available" @(availableOnly ? "checked" : "")>
                    <label class="form-check-label" for="availabilityAvailable">Available Only</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="availabilityFilter"
                        id="availabilityUnavailable" value="unavailable" @(unavailableOnly ? "checked" : "")>
                    <label class="form-check-label" for="availabilityUnavailable">Unavailable Only</label>
                </div>
            </div>
        </div> *@
        
        <!-- Action buttons - now in their own column -->
        <div class="col-md-3 d-flex justify-content-end align-items-end">
            <div class="btn-group" role="group">
                <button type="submit" class="btn btn-primary" title="Search">
                    <i class="bi bi-search"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-secondary" title="Reset">
                    <i class="bi bi-arrow-counterclockwise"></i> Clear
                </a>
            </div>
        </div>
    </div>
    <div class="row">
        <!-- Availability filter - Radio buttons -->
        <div class="col-md-12 mt-3">
            <label class="form-label d-block">Availability</label>
            <div class="d-flex flex-row align-items-center gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="availabilityFilter" 
                        id="availabilityAll" value="all" @(!availableOnly && !unavailableOnly ? "checked" : "")>
                    <label class="form-check-label" for="availabilityAll">All Venues</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="availabilityFilter" 
                        id="availabilityAvailable" value="available" @(availableOnly ? "checked" : "")>
                    <label class="form-check-label" for="availabilityAvailable">Available Only</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="availabilityFilter"
                        id="availabilityUnavailable" value="unavailable" @(unavailableOnly ? "checked" : "")>
                    <label class="form-check-label" for="availabilityUnavailable">Unavailable Only</label>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Rest of your table and other HTML remains the same -->

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.BookingId)</th>
                <th>Event</th>
                <th>Type</th>
                <th>Venue</th>
                <th>@Html.DisplayNameFor(model => model.BookingDate)</th>
                <th>Event Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.BookingId)</td>
                    <td>@item.EventName</td>
                    <td>@item.EventType</td>
                    <td>@item.VenueName <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                        @(item.IsAvailable ? "Available" : "Unavailable")
                    </span></td>
                    <td>@item.BookingDate.ToString("g")</td>
                    <td>@item.EventDate.ToString("g")</td>
                    <td>
                        <div class="btn-group float-end" role="group">
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        No bookings found. Would you like to <a asp-action="Create">create one</a>?
    </div>
}