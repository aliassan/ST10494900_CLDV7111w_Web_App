@model IEnumerable<BookingDetail>

@{
    ViewData["Title"] = "Bookings";
    // Get current filter values from ViewData
    var searchString = ViewData["CurrentFilter"] as string;
    var eventTypeId = ViewData["EventTypeFilter"] as int?;
    var fromDate = ViewData["FromDateFilter"] as string;
    var toDate = ViewData["ToDateFilter"] as string;
    var availableOnly = ViewData["AvailableOnlyFilter"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Bookings</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</div>

<!-- Enhanced Search Form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3">
        <!-- Original search input -->
        <div class="col-md-4">
            <div class="input-group">
                <input type="text" name="searchString" value="@searchString" 
                       class="form-control" placeholder="Search by Booking ID or Event Name...">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </div>
        
        <!-- New filters -->
        <div class="col-md-2">
            <select name="eventTypeId" class="form-select" onchange="this.form.submit()">
                <option value="">All Event Types</option>
                @foreach (var type in ViewBag.EventTypes as IEnumerable<EventType> ?? new List<EventType>())
                {
                    <option value="@type.EventTypeId" selected="@(eventTypeId == type.EventTypeId)">
                        @type.TypeName
                    </option>
                }
            </select>
        </div>
        
        <div class="col-md-2">
            <input type="date" name="fromDate" value="@fromDate" 
                   class="form-control" placeholder="From Date" onchange="this.form.submit()">
        </div>
        
        <div class="col-md-2">
            <input type="date" name="toDate" value="@toDate" 
                   class="form-control" placeholder="To Date" onchange="this.form.submit()">
        </div>
        
        <div class="col-md-2 d-flex align-items-center">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="availableOnly" 
                       id="availableOnly" @(availableOnly ? "checked" : "") onchange="this.form.submit()">
                <label class="form-check-label" for="availableOnly">Available Only</label>
            </div>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.BookingId)</th>
                <th>Event</th>
                <th>Type</th>
                <th>Venue</th>
                <th>@Html.DisplayNameFor(model => model.BookingDate)</th>
                <th>Event Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.BookingId)</td>
                    <td>@item.EventName</td>
                    <td>@item.EventType</td>
                    <td>@item.VenueName <span class="badge @(item.IsAvailable ? "bg-success" : "bg-warning")">
                        @(item.IsAvailable ? "Available" : "Booked")
                    </span></td>
                    <td>@item.BookingDate.ToString("g")</td>
                    <td>@item.EventDate.ToString("g")</td>
                    <td>
                        <div class="btn-group float-end" role="group">
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        No bookings found. Would you like to <a asp-action="Create">create one</a>?
    </div>
}