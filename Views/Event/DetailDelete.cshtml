@model EventEase.Models.Event

@{
    bool isDeleteMode = ViewData["ViewMode"]?.ToString() == "Delete";
    ViewData["Title"] = isDeleteMode ? "Delete Event" : "Event Details";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EventName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EventName)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EventDate)</dt>
                <dd class="col-sm-9">@Model.EventDate.ToString("f")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Venue)</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Venue!.VenueName)
                    @if (Model.Venue == null)
                    {
                        <span class="text-muted">No venue assigned</span>
                    }
                </dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <dt class="col-sm-3">Event Image</dt>
                    <dd class="col-sm-9">
                        <img src="@Model.ImageUrl" alt="Event image" class="img-fluid rounded" style="max-height: 200px;" />
                    </dd>
                }
            </dl>
        </div>
    </div>

    @if (isDeleteMode)
    {
        <div class="alert alert-danger mt-4">
            <h5>Warning!</h5>
            <p class="mb-0">This action will permanently delete the event. Associated bookings will also be removed.</p>
        </div>
    }

    <div class="mt-4">
        @if (isDeleteMode)
        {
            <form asp-action="Delete">
                <input type="hidden" asp-for="EventId" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </form>
        }
        else
        {
            <div>
                <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.EventId" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-list-ul"></i> Back to List
                </a>
            </div>
        }
    </div>
</div>