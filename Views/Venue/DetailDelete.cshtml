@model EventEase.Models.Venue

@{
    bool isDeleteMode = ViewData["ViewMode"]?.ToString() == "Delete";
    ViewData["Title"] = isDeleteMode ? "Delete Venue" : "Venue Details";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @ViewData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.VenueName)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.VenueName)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Location)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Location)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Capacity)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Capacity)</dd>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <dt class="col-sm-4">Venue Image</dt>
                    <dd class="col-sm-8">
                        <img src="@Model.ImageUrl" alt="Venue Image" class="img-fluid" style="max-height: 200px;" />
                    </dd>
                }
            </dl>
        </div>
    </div>

    @* @if (isDeleteMode)
    {
        <div class="alert alert-danger mt-4">
            <h5>Are you sure you want to delete this venue?</h5>
            <p class="mb-0">This action cannot be undone.</p>
        </div>
    } *@

    @if (isDeleteMode)
    {
        <div class="alert @(ViewData["ErrorMessage"] == null ? "alert-warning" : "alert-danger") mt-4">
            <h5>@(ViewData["ErrorMessage"] == null ? "Warning!" : "Delete Restricted")</h5>
            <p class="mb-0">
                @if (ViewData["ErrorMessage"] == null)
                {
                    <text>This action will permanently delete the venue.</text>
                }
                else
                {
                    @ViewData["ErrorMessage"]
                }
            </p>
        </div>
    }

    <div class="mt-4">
        @if (isDeleteMode)
        {
            @* <form asp-action="Delete">
                <input type="hidden" asp-for="VenueId" />
                <button type="submit" class="btn btn-danger me-2">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </form> *@

            <form asp-action="Delete">
                <input type="hidden" asp-for="VenueId" />
                <button type="submit" class="btn btn-danger" @(ViewData["ErrorMessage"] != null ? "disabled" : "")>
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </form>
        }
        else
        {
            <div>
                <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-warning me-2">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.VenueId" class="btn btn-danger me-2">
                    <i class="bi bi-trash"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-list-ul"></i> Back to List
                </a>
            </div>
        }
    </div>
</div>